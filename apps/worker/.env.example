# Sokosumi (Coworker « Richard »)
COWORKER_ID=
SOKOSUMI_COWORKER_API_KEY=

# Agent eve
EVE_URL=http://127.0.0.1:21949
ROUTE_AUTH_BASIC_USER=
ROUTE_AUTH_BASIC_PASSWORD=

# Worker
WORKER_DATA_DIR=.local
POLL_INTERVAL_MS=5000
INTAKE_TIMEOUT_MS=1800000
PAID_TASKS_ENABLED=false

# Paiement Masumi (M2) — la clé MPS limitée est créée par `npm run registration -- key` dans WORKER_DATA_DIR
MPS_URL=http://127.0.0.1:3012
BLOCKFROST_API_KEY_PREPROD=

# Enregistrement Masumi uniquement (jamais dans le worker en production)
MPS_ADMIN_KEY=
MPS_SELLING_WALLET_ID=
MPS_PAYMENT_SOURCE_ID=
REACH_MODEL=gpt-6.1-sol

# API standard Masumi (MIP-003)
AGENT_API_PORT=21950
AGENT_API_PUBLIC_URL=
