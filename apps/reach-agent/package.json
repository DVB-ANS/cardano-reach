{
  "name": "reach-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/launch.ts dev",
    "build": "eve build",
    "start": "node scripts/launch.ts start",
    "typecheck": "tsc -p tsconfig.json",
    "research": "node --env-file-if-exists=.env.local scripts/research.ts",
    "bench": "node --env-file-if-exists=.env.local scripts/bench-search.ts",
    "golden": "node --env-file-if-exists=.env.local scripts/golden.ts",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "ai": "7.0.127",
    "eve": "0.71.0",
    "just-bash": "3.6.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
